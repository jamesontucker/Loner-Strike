 "comments": [
  {
   "id": "c1",
   "text": "Free for all, no buying, and you come back 2 seconds after you die, with the gun of your level and 2 seconds of God Mode so nobody is shot as they appear.",
   "pos": {
    "x": 41,
    "y": 4
   },
   "size": {
    "w": 2278,
    "h": 670
   }
  },
  {
   "id": "c2",
   "text": "A kill by another player moves the killer up a level and hands over the next gun at once. After the last gun in the Guns table comes the knife, and a kill with it wins. A suicide costs a level.",
   "pos": {
    "x": 41,
    "y": 697
   },
   "size": {
    "w": 3278,
    "h": 1195
   }
  },
  {
   "id": "c3",
