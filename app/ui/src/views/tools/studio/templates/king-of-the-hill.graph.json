 "comments": [
  {
   "id": "c1",
   "text": "Each round a capture point is made on the hill: the map's Hill marker, else bomb site A, else where the hostages are. Bots go for it by themselves.",
   "pos": {
    "x": 41,
    "y": 4
   },
   "size": {
    "w": 2778,
    "h": 621
   }
  },
  {
   "id": "c2",
   "text": "Who holds the hill: Point Captured says which team took it, Point Lost that nobody has it now.",
   "pos": {
    "x": 41,
    "y": 1785
   },
   "size": {
    "w": 1778,
    "h": 398
   }
  },
  {
   "id": "c3",
   "text": "Every second the team on the hill scores a point (Hill Score is kept per team) and everyone sees it. 120 wins the round.",
   "pos": {
    "x": 1041,
    "y": 672
   },
   "size": {
    "w": 3778,
    "h": 588
   }
  },
  {
   "id": "c4",
   "text": "No bomb in this mode: on a bomb map the game hands one out each round, so at Round Started everyone loses it (Remove Weapon, the bomb). Bots then play the mode instead of the bomb, and a bomb can't end a round behind the mode's back.",
   "pos": {
    "x": 41,
    "y": 1335
   },
   "size": {
    "w": 1278,
    "h": 202
   }
  },
  {
   "id": "c5",
   "text": "Make Hill: a capture point at the place given, kept in the Hill variable. Taking it alone takes 6 seconds, faster with friends.",
   "pos": {
    "x": 41,
    "y": 1549
   },
   "size": {
    "w": 1278,
    "h": 224
   },
   "graph": "hill"
  }
 ],
