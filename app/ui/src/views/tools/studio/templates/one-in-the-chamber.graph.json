 "comments": [
  {
   "id": "c1",
   "text": "Free for all, no buying. Everyone spawns with a knife and a deagle holding a single bullet.",
   "pos": {
    "x": 41,
    "y": 4
   },
   "size": {
    "w": 2278,
    "h": 482
   }
  },
  {
   "id": "c2",
   "text": "A deagle bullet always kills (the knife hurts as usual). Player About To Be Hurt can change the damage before it lands.",
   "pos": {
    "x": 41,
    "y": 527
   },
   "size": {
    "w": 2278,
    "h": 243
   }
  },
  {
   "id": "c3",
   "text": "A kill gives the killer one more bullet. The one who died loses a life, and comes back after 2 seconds if they have any left.",
   "pos": {
    "x": 41,
    "y": 789
   },
   "size": {
    "w": 4778,
    "h": 675
   }
  },
  {
   "id": "c4",
   "text": "After each death, count who still has lives. When only one is left, they win and a new round starts with three lives each.",
   "pos": {
    "x": 41,
    "y": 1544
   },
   "size": {
    "w": 3278,
    "h": 428
   }
  }
 ]
}
