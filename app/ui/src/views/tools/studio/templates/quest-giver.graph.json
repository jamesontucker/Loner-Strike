  "comments": [
    {
      "id": "c1",
      "text": "As the map starts, Old Sam stands by the Counter-Terrorist spawn and his note lies by the Terrorist spawn (spots on de_dust2: change the points for another map). The quest is two per-player flags: On Sam's Quest and Has the Note. They start false on every map, and a player who joins gets fresh ones.",
      "pos": {
        "x": 41,
        "y": 22
      },
      "size": {
        "w": 1500,
        "h": 430
      }
    },
    {
      "id": "c2",
      "text": "Press E on Sam. Has the note: he pays $1000 and both flags clear. On the quest without it: a hint. Otherwise he asks, and Yes puts you on the quest.",
      "pos": {
        "x": 41,
        "y": 470
      },
      "size": {
        "w": 3500,
        "h": 900
      }
    },
    {
      "id": "c3",
      "text": "Press E on the note: on the quest and not yet carrying it, you take it (Has the Note). Otherwise it's just an old note.",
      "pos": {
        "x": 41,
        "y": 1580
      },
      "size": {
        "w": 3000,
        "h": 760
      }
    }
  ]
