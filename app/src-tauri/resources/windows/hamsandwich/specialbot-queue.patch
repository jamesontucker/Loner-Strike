diff --git a/modules/hamsandwich/hook_specialbot.cpp b/modules/hamsandwich/hook_specialbot.cpp
index 9f9469e3..9f354085 100644
--- a/modules/hamsandwich/hook_specialbot.cpp
+++ b/modules/hamsandwich/hook_specialbot.cpp
@@ -123,3 +123,16 @@ void CHamSpecialBotHandler::RegisterChecked(AMX *amx, int &func, const char *fun
 		hook->pre.append(pfwd);
 	}
 }
+
+// Loner-Strike fix: registrations queued before any bot joined hold the plugin's AMX and a
+// Forward they don't own a reference to. Both are freed when plugins unload at a map change,
+// so the queue must go too; otherwise the first bot on a later map makes RegisterChecked
+// AddRef freed memory (heap corruption on Windows).
+void CHamSpecialBotHandler::ClearPending()
+{
+	for (size_t i = 0; i < m_RHP_list.length(); ++i)
+	{
+		delete m_RHP_list.at(i);
+	}
+	m_RHP_list.clear();
+}
