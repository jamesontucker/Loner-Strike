{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loner-Strike",
  "version": "0.1.3",
  "identifier": "gg.lonerstrike.app",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeDevCommand": {
      "script": "npm run build",
      "cwd": "../ui",
      "wait": true
    },
    "beforeBuildCommand": {
      "script": "npm ci && npm run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "homepage": "https://lonerstrike.com",
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "category": "Game",
    "shortDescription": "Solo Counter-Strike with bots that play like people.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../plugins/": "plugins/",
      "../../mods/": "mods/",
      "../../catalog/": "catalog/",
      "resources/windows/hamsandwich/": "windows/hamsandwich/",
      "resources/linux/ls-control/": "linux/ls-control/",
      "resources/linux/ls-voice/": "linux/ls-voice/",
      "resources/linux/ls-intent/": "linux/ls-intent/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxNDc0NkE1MEU0QUNBMTAKUldRUXlrb09wVVpITWFkeC8zTlArNnYxWnV4WlZ1N0JIQnh2M29xdGNwMWMyc3VRSVhhdjFEZEcK",
      "endpoints": [
        "https://dl.lonerstrike.com/app/latest.json",
        "https://github.com/jamesontucker/Loner-Strike/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
