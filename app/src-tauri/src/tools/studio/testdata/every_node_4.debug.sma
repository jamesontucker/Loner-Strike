	RegisterHam(Ham_Item_Deploy, "weapon_flashbang", "lsg_eng_deploy", 1)
	RegisterHam(Ham_Item_Deploy, "weapon_smokegrenade", "lsg_eng_deploy", 1)
	RegisterHam(Ham_Item_Deploy, "weapon_c4", "lsg_eng_deploy", 1)
	register_impulse(100, "lsg_eng_impulse")
	register_forward(FM_PlayerPreThink, "lsg_eng_think", 0)
	register_message(get_user_msgid("ScoreAttrib"), "lsg_eng_attr")
	register_message(get_user_msgid("TeamInfo"), "lsg_eng_teaminfo")
	register_forward(FM_ClientDisconnect, "lsg_eng_left", 0)
}

public plugin_end()
{
	lsd_end()
}

stock lsg_stop_timers()
{
	for (new i = 0; i < LSG_N; i++)
		remove_task(LSG_TASK + i)
}

public lsg_on_player_killed()
{
	new v = read_data(2), a = read_data(1), wpn[24]
	read_data(4, wpn, charsmax(wpn))
	new ctx[LSG_CTX]
	ctx[0] = v // victim
	ctx[1] = a // attacker
	ctx[2] = read_data(3) ? 1 : 0 // headshot
	copy(g_lsgTxt[0], 63, wpn) // weapon
	ctx[3] = _:lsg_dist(a, v) // distance
	ctx[4] = a != v && lsg_ok(a) && lsg_ok(v) && get_user_team(a) == get_user_team(v) ? 1 : 0 // team_kill
	ctx[5] = a == v ? 1 : 0 // suicide
	ctx[6] = lsg_ok(a) ? 0 : 1 // world
	lsg_n16(ctx)
}

public lsg_on_player_spawned(id)
{
	if (!is_user_alive(id))
		return HAM_IGNORED
	new ctx[LSG_CTX]
	ctx[0] = id // player
	lsg_n0(ctx)
	return HAM_IGNORED
}

// Player Spawned (ps)
lsg_n0(ctx[])
{
	if (lsd_want(0))
	{
	lsd_begin()
	}
	if (lsd_enter(0, ctx))
		return
	lsd_exit(0, "ran")
	lsg_n1(ctx)
}

