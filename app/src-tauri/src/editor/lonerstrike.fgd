// Loner-Strike game mode components (gm_components.amxx). Written for Loner-Strike; same licence
// as the rest of it. Standard FGD syntax, so other editors can read it too. Every class here
// needs the gm_components plugin on the server (a game mode that lists it); without it the game
// leaves these entities out. Keys, events and what bots make of each: docs/COMPONENTS.md.
// Times called "after the round starts" count from the end of freeze time.

// ---- shared pieces ----------------------------------------------------------------------

@BaseClass = LsName
[
	targetname(target_source) : "Name" : : "What map logic and modes call this component. A button whose target is this name sets it off."
	name(string) : "Label" : : "A short name players see (B, North gate). Uses the Name when empty."
	enabled(choices) : "On at round start" : 1 : "Off: it does nothing until a mode or map logic switches it on." =
	[
		1 : "Yes"
		0 : "No"
	]
]
@BaseClass = LsTarget [ target(target_destination) : "Sets off" : : "What to set off when its main thing happens (taken, opened, extracted, broken...)." ]
@BaseClass = LsTeam
[
	team(choices) : "Team" : 0 : "Which team this is for." =
	[
		0 : "Anyone"
		1 : "Terrorists"
		2 : "Counter-Terrorists"
	]
]
@BaseClass = LsArea
[
	radius(float) : "Radius" : 128 : "How far from the middle counts as inside (units). Ignored when Box size is set."
	height(float) : "Height" : 160 : "How far above the floor counts as inside."
	size(string) : "Box size (x y z)" : : "Use a box instead of a circle: width, depth and height in units, centered on the point."
]
@BaseClass = LsTier
[
	friendly(choices) : "Side" : "" : "On the players' side: shoots creatures only, and creatures attack it (a turret the players own)." = [ "" : "The type's own" "0" : "Enemy" "1" : "Players' side" ]
	tier(choices) : "Tier" : 1 : "How good the loot is. Also its glow color." =
	[
		1 : "1 - common (gray)"
		2 : "2 - good (green)"
		3 : "3 - rare (blue)"
		4 : "4 - epic (purple)"
		5 : "5 - best (gold)"
	]
]

// ---- spawns and players ------------------------------------------------------------------

@PointClass base(LsName, LsTeam) size(-16 -16 -36, 16 16 36) color(80 200 255) studio("models/player/gign/gign.mdl") = ls_respawn_point : "Where players of a team (re)spawn in a mode. When a map has any for a team, that team spawns only at these, at a free one."
[
	angle(angle) : "Facing" : 0 : "Which way the player faces, seen from above."
	protect_secs(float) : "Spawn protection" : 3 : "Seconds the player can't be hurt after spawning here (glows meanwhile)."
	role(string) : "Role" : : "For the Mode Kit: only players with this role spawn here."
]

@PointClass base(LsTeam) size(-8 -8 -8, 8 8 8) color(200 160 255) = ls_player_class : "A player class: health, speed, weapons, model. Players pick one with say /class, or a mode gives it."
[
	name(string) : "Class name" : "Soldier" : "What the class is called in menus and in mode code."
	enabled(choices) : "On at round start" : 1 : "Off: not offered or given." = [ 1 : "Yes" 0 : "No" ]
	hp(integer) : "Health" : 100 : "Health at spawn."
	armor(integer) : "Armor" : 0 : "Armor at spawn."
	helmet(choices) : "Helmet" : 1 : "With a helmet when armor is given." = [ 1 : "Yes" 0 : "No" ]
	speed(float) : "Speed" : 0 : "Running speed (250 is normal with a knife). 0 keeps the weapon's own speed."
	gravity(float) : "Gravity" : 1 : "1 is normal, 0.5 jumps twice as high."
	weapons(string) : "Weapons" : "knife" : "Given at spawn, separated by spaces: knife deagle ak47 vesthelm he hp:50 ..."
	strip(choices) : "Take other weapons" : 1 : "Take the game's starting weapons first." = [ 1 : "Yes" 0 : "No" ]
	model(string) : "Player model" : : "A model folder under models/player (terror, vip). Empty keeps the team's."
	limit(integer) : "Most players" : 0 : "How many can have it at once (0 = no limit)."
	menu(choices) : "In the class menu" : 1 : "Players can pick it from say /class." = [ 1 : "Yes" 0 : "No" ]
	default(choices) : "Given to everyone" : 0 : "Players of the team without a class get this one." = [ 0 : "No" 1 : "Yes" ]
	bot_profile(string) : "Bot behavior" : : "A behavior profile for bots with this class (botprofiles.ini: hunter, defender ...)."
]

// ---- zones -------------------------------------------------------------------------------

@PointClass base(LsName) size(-24 -24 -24, 24 24 24) color(80 160 255) = ls_safe_zone : "The safe circle (battle royale). Players outside it take damage. Put one in the middle of the play area."
[
	radius(float) : "Radius" : 3000 : "The circle's size at round start."
	damage(float) : "Damage outside" : 1 : "Damage per tick outside (a shrinker changes it per stage)."
	interval(float) : "Seconds per tick" : 1 : "How often players outside are hurt."
]

@PointClass base(LsName) size(-8 -8 -8, 8 8 8) color(80 160 255) = ls_zone_shrinker : "Shrinks a safe zone in stages: warn (next circle shown), then close in, with more damage each stage."
[
	zone(target_destination) : "Safe zone" : : "The safe zone's Name (empty = the first one)."
	stages(string) : "Stages" : "2400:60:40:1 1600:45:35:2 900:40:30:4 400:30:25:8 0:20:20:15" : "Each stage as radius:warn seconds:shrink seconds:damage, separated by spaces."
	start_delay(float) : "Starts after" : 30 : "Seconds after the round starts (-1 = when a mode starts it)."
	random_center(choices) : "Random centers" : 1 : "Each next circle lands somewhere inside the last one." = [ 1 : "Yes" 0 : "No (stays centered)" ]
	final_r(float) : "Smallest radius" : 0 : "Never smaller than this."
	roundtime(choices) : "Show in round clock" : 1 : "The round timer counts down to the next change." = [ 1 : "Yes" 0 : "No" ]
]

@PointClass base(LsName, LsArea) size(-16 -16 -16, 16 16 16) color(255 60 30) = ls_damage_zone : "Hurts players inside: fire, poison, shock. Bots route around it."
[
	radius(float) : "Radius" : 96 : "How far from the middle hurts."
	dmg(float) : "Damage" : 10 : "Damage per tick."
	interval(float) : "Seconds per tick" : 1 : "How often."
	kind(choices) : "Kind" : "fire" : "The damage type and screen color." =
	[
		"fire" : "Fire"
		"poison" : "Poison"
		"shock" : "Shock"
		"radiation" : "Radiation"
		"generic" : "Plain"
	]
	team(choices) : "Hurts" : 0 : "Who it hurts." = [ 0 : "Everyone" 1 : "Terrorists" 2 : "Counter-Terrorists" ]
	hud_warning(choices) : "Warning on screen" : 1 : "Shows Danger: fire while inside." = [ 1 : "Yes" 0 : "No" ]
	show(choices) : "Red ring" : 1 : "Draw its edge for players nearby." = [ 1 : "Yes" 0 : "No" ]
]

@PointClass base(LsName, LsTarget, LsArea) size(-16 -16 -16, 16 16 16) color(255 220 40) = ls_capture_point : "A point teams take by standing on it, and hold. Bots attack and defend it."
[
	capture_secs(float) : "Seconds to take" : 10 : "With one player on it."
	multiplier(choices) : "More players, faster" : 1 : "Up to 3 times faster with 3 players." = [ 1 : "Yes" 0 : "No" ]
	decay(float) : "Decay" : 1 : "How fast a half-taken point goes back when nobody is on it (0 = keeps progress)."
	team_lock(choices) : "Who can take it" : 0 : "" = [ 0 : "Both teams" 1 : "Only Terrorists" 2 : "Only Counter-Terrorists" ]
	start_owner(choices) : "Held at start by" : 0 : "" = [ 0 : "Nobody" 1 : "Terrorists" 2 : "Counter-Terrorists" ]
	ffa(choices) : "Every player for themselves" : 0 : "Held by one player instead of a team (King of the Hill)." = [ 0 : "No" 1 : "Yes" ]
]

@PointClass base(LsName, LsTarget, LsArea, LsTeam) size(-16 -16 -16, 16 16 16) color(60 255 90) = ls_extraction_zone : "Players who stay inside long enough while it's open get out (and are done for the round)."
[
	hold_secs(float) : "Seconds to extract" : 8 : "How long a player stays inside."
	open_at(float) : "Opens after" : 0 : "Seconds after the round starts (-1 = when a mode or button opens it)."
	close_at(float) : "Closes after" : -1 : "Seconds after the round starts (-1 = never)."
	cost(integer) : "Cost" : 0 : "Money it takes to extract here."
	shared(choices) : "Faster together" : 0 : "Each extra player inside makes it 50% faster." = [ 0 : "No" 1 : "Yes" ]
	once(choices) : "Once per round" : 1 : "" = [ 1 : "Yes" 0 : "No" ]
	action(choices) : "Then" : "spectate" : "What happens to a player who extracted." =
	[
		"spectate" : "Out of the round (no death counted)"
		"strip" : "Stays, weapons taken"
		"none" : "Nothing (the mode decides)"
	]
]

@PointClass base(LsName, LsTarget, LsArea, LsTeam) size(-16 -16 -16, 16 16 16) color(255 220 60) = ls_checkpoint : "A gate in a race. Players pass them in order; passing the last one finishes a lap."
[
	order(integer) : "Order" : 1 : "1 is the start; the highest number finishes the lap."
	radius(float) : "Radius" : 96 : ""
]

@PointClass base(LsName, LsTarget, LsArea) size(-16 -16 -16, 16 16 16) color(255 200 140) = ls_meeting_point : "Players hold USE here to call a meeting: everyone gathers, talks and votes someone out."
[
	radius(float) : "Radius" : 160 : "Where players can call it from and gather around."
	duration(float) : "Seconds" : 45 : "How long the meeting lasts."
	cooldown(float) : "Cooldown" : 60 : "Seconds before another can be called."
	calls(integer) : "Calls per player" : 1 : "Per round (0 = no limit)."
	callers(choices) : "Who can call" : 0 : "" = [ 0 : "Any player" 1 : "Only the mode" ]
	freeze(choices) : "Freeze players" : 1 : "" = [ 1 : "Yes" 0 : "No" ]
	gather(choices) : "Bring everyone here" : 1 : "" = [ 1 : "Yes" 0 : "No" ]
]

// ---- loot --------------------------------------------------------------------------------

@PointClass base(LsName, LsTier) size(-8 -8 0, 8 8 8) color(255 170 0) studio("models/w_ak47.mdl") = ls_weapon_spawner : "A weapon or item lying on the floor that comes back after it's taken. Walk over it to pick it up."
[
	item(string) : "Item" : "table:default" : "ak47, deagle, vesthelm, he, hp:50, ammo ... or table:<name> to roll from a loot table."
	respawn_secs(float) : "Comes back after" : 30 : "Seconds (0 = once per round)."
	once(choices) : "Once per round" : 0 : "" = [ 0 : "No" 1 : "Yes" ]
]

@PointClass base(LsName, LsTarget, LsTier) size(-16 -16 0, 16 16 24) color(255 170 0) studio("models/w_weaponbox.mdl") = ls_loot_container : "A crate players hold USE on to open; it gives a few items from a loot table."
[
	table(string) : "Loot table" : "default" : "A [table] in configs/gamemodes/loot.ini."
	items(integer) : "Items" : 2 : "How many items it gives."
	open_secs(float) : "Seconds to open" : 2 : ""
	once(choices) : "Once per round" : 1 : "" = [ 1 : "Yes" 0 : "No" ]
	respawn_secs(float) : "Refills after" : 0 : "Seconds (0 = not this round)."
	glow(choices) : "Glow by tier" : 1 : "" = [ 1 : "Yes" 0 : "No" ]
	model(studio) : "Model" : : "Empty: a weapon box."
]

@PointClass base(LsName, LsTarget, LsTier) size(-16 -16 0, 16 16 24) color(255 90 60) studio("models/mil_crate.mdl") = ls_supply_drop : "Where a supply crate can fall from the sky, with a beacon. Players hold USE on it to open it."
[
	at(float) : "Falls after" : -1 : "Seconds after the round starts (-1 = when a mode or button calls it)."
	chance(integer) : "Chance" : 100 : "Percent chance it comes at all."
	fall_secs(float) : "Seconds falling" : 20 : ""
	table(string) : "Loot table" : "drop" : ""
	items(integer) : "Items" : 4 : ""
	open_secs(float) : "Seconds to open" : 3 : ""
	beacon(choices) : "Beacon" : 1 : "A red beam above it until it's opened." = [ 1 : "Yes" 0 : "No" ]
]

// ---- doors, traps, defences --------------------------------------------------------------

@PointClass base(LsName, LsTarget, LsTeam) size(-8 -8 -8, 8 8 8) color(200 200 80) = ls_timed_door : "Opens, closes and locks func_doors on a timetable. Players may lock it for a while. Bots go round a locked door."
[
	door(target_destination) : "Door" : : "The Name of the func_door / func_door_rotating (all doors with that name), or its brush model (*12) in a map pack."
	open_at(float) : "Opens after" : -1 : "Seconds after the round starts (-1 = never by itself)."
	close_at(float) : "Closes after" : -1 : "Seconds after the round starts (-1 = never by itself)."
	open_secs(float) : "Closes again after" : 0 : "Seconds after it opens (0 = stays open)."
	locked_until(float) : "Locked until" : 0 : "Players can't open it before this many seconds into the round."
	lockable(choices) : "Players can lock it" : 0 : "Hold USE by the door to lock it." = [ 0 : "No" 1 : "Yes" ]
	lock_time(float) : "Seconds to lock" : 3 : ""
	lock_secs(float) : "Stays locked for" : 10 : ""
]

@PointClass base(LsName, LsTarget, LsArea) size(-16 -16 -16, 16 16 16) color(255 80 80) = ls_trigger_trap : "A trap: sets off its targets (and hurts players inside) when someone walks in, or when a button or mode fires it."
[
	fire_on(choices) : "Goes off" : "touch" : "" = [ "touch" : "When someone walks in" "use" : "Only from a button or mode" ]
	team_only(choices) : "Set off by" : 0 : "Who walking in sets it off." = [ 0 : "Anyone" 1 : "Terrorists" 2 : "Counter-Terrorists" ]
	delay(float) : "Delay" : 0 : "Seconds between being set off and going off."
	dmg(float) : "Damage" : 0 : "Damage to players inside when it goes off."
	rearm_secs(float) : "Rearms after" : 5 : "Seconds (0 = once per round)."
	armed(choices) : "Armed at start" : 1 : "" = [ 1 : "Yes" 0 : "No" ]
	danger(choices) : "Bots avoid it" : 0 : "Bots keep away even without damage set." = [ 0 : "No" 1 : "Yes" ]
	trap_kind(string) : "Kind" : : "A word for the mode (laser, crusher, alarm)."
	cost(integer) : "Price" : 0 : "With Goes off = use: a player holding USE at it pays this to set it off (a paid trap, like Last Stand's electric trap)."
	active_secs(float) : "Stays on" : 0 : "Seconds it stays on once set off, hurting creatures inside (0: goes off once)."
	creature_dps(float) : "Creature damage a second" : 80 : "While on."
	creature_dps_pct(float) : "Creature damage a second (share of health)" : 0.16 : "While on, on top: 0.16 = 16 % of a creature's full health."
	player_dps(float) : "Player damage a second" : 4 : "While on, to players inside (never below 5 health)."
	bots_auto(choices) : "Bots switch it on" : 1 : "A bot close by pays for it when 4+ creatures are near." = [ 1 : "Yes" 0 : "No (only by the bots' brain)" ]
]

@PointClass base(LsName, LsTeam) size(-8 -8 0, 8 8 16) color(220 60 60) studio("models/w_medkit.mdl") = ls_perk_machine : "Sells one perk for as long as the player lives (lost when downed). Hold USE at it to buy."
[
	perk(choices) : "Perk" : "tough" : "" = [ "tough" : "Tough (+50% max health)" "hands" : "Quick hands (faster reloads and swaps)" "doubletap" : "Double tap (+25% damage)" "revive" : "Quick revive (revive in 2 s; alone, get back up once)" "feet" : "Light feet (+10% speed)" ]
	price(integer) : "Price" : 1500 : "For a player's first perk."
	price_step(integer) : "Dearer by" : 1000 : "For each perk the player already has."
	max_perks(integer) : "Perks at most" : 4 : "0 = no limit."
	model(studio) : "Model" : : "Empty: a medkit."
	bots(choices) : "Bots buy here" : 1 : "" = [ 1 : "Yes" 0 : "No" ]
]

@PointClass base(LsName, LsTeam) size(-8 -8 0, 8 8 16) color(255 140 0) studio("models/w_assault.mdl") = ls_upgrade_bench : "Upgrades the gun in hand: Mk II (+40% damage, a magazine and a half), then Mk III (+90%). The level stays with the gun."
[
	price2(integer) : "Mk II price" : 5000 : ""
	price3(integer) : "Mk III price" : 9000 : ""
	level3_from(integer) : "Mk III from wave" : 12 : "0 = any time."
	dmg2(float) : "Mk II damage" : 1.4 : "Times the gun's own."
	dmg3(float) : "Mk III damage" : 1.9 : ""
	model(studio) : "Model" : : "Empty: a rifle."
	bots(choices) : "Bots buy here" : 1 : "" = [ 1 : "Yes" 0 : "No" ]
]

@PointClass base(LsName, LsTeam) size(-16 -16 0, 16 16 24) color(80 200 255) studio("models/w_weaponbox.mdl") = ls_mystery_box : "A random gun for a price. Of the boxes in one group, one is out at a time; after a few uses it moves to another."
[
	price(integer) : "Price" : 950 : ""
	guns(string) : "Guns and weights" : "mp5navy:10 ump45:10 famas:8 galil:8 m3:8 xm1014:6 deagle:8 scout:5 p90:8 m4a1:5 ak47:5 aug:4 sg552:4 awp:3 m249:2" : "gun:weight, the weapon names without weapon_."
	super(string) : "The rare one" : "m249" : "This gun comes as a Mk II with a long magazine."
	super_clip(integer) : "Its magazine" : 150 : ""
	super_name(string) : "Its name" : "the Grinder" : ""
	moves_after(string) : "Moves after" : "4-8" : "Uses before it moves (a range or one number; 0 = never)."
	group(string) : "Group" : "box" : "Boxes in the same group take turns."
	model(studio) : "Model" : : "Empty: a weapon box."
	bots(choices) : "Bots use it" : 1 : "" = [ 1 : "Yes" 0 : "No" ]
]

@PointClass base(LsName, LsTeam, LsArea) size(-16 -16 0, 16 16 72) color(255 200 60) = ls_shop : "A shop counter: players inside press USE for a menu of priced items. Can have a shopkeeper (Barney or the G-Man) who greets and thanks them."
[
	items(string) : "Items" : "Armor|650|vesthelm|kevlar + helmet; Ammo|300|ammo|refill all your guns; Medkit|500|hp:50|+50 HP" : "Name|price|give|what, separated by ;. give: an item (ammo, vesthelm, hp:50, hegrenade, a weapon name) or @word for the mode to hand out."
	price_rise(float) : "Dearer each wave" : 0 : "0.05 = 5 % more each wave."
	scale(float) : "Price scale" : 1 : ""
	upgrades(choices) : "Sells upgrades" : 0 : "The perks and the gun upgrade, when the map has no perk machine or bench." = [ 0 : "No" 1 : "Yes" ]
	buy_menu(choices) : "Gun menu line" : 0 : "A last line opening the game's buy menu (works where it's a buy zone)." = [ 0 : "No" 1 : "Yes" ]
	keeper(string) : "Shopkeeper" : "none" : "barney, gman, none, or a model (loaded with the map)."
	keeper_name(string) : "Shopkeeper's name" : : "Empty: Barney or G-Man."
	greet(string) : "Greeting" : : "What the shopkeeper says to someone walking in (their first 3 visits)."
	hint(string) : "Hint" : : "Shown on walking in."
	title(string) : "Menu title" : : "Empty: the Name, else Shop."
	open(choices) : "Open" : 1 : "A mode can open and close it." = [ 1 : "Yes" 0 : "No" ]
]

@SolidClass base(LsName, LsTarget, LsTeam) color(180 120 60) = ls_barricade : "A wall that can be shot or hit down and repaired (hold USE). Bots defend behind it and go round it while it stands."
[
	hp(integer) : "Health" : 500 : ""
	label(string) : "Gate name" : : "Shown in Last Stand's gates list ('West gate'). Empty: the Name, else a compass point from the base."
	team(choices) : "Defended by" : 2 : "This team repairs it and can't damage it." = [ 0 : "Nobody" 1 : "Terrorists" 2 : "Counter-Terrorists" ]
	repair_secs(float) : "Seconds per repair" : 3 : "Each repair adds a quarter of its health."
	repair_cost(integer) : "Repair cost" : 0 : "Money per repair."
	blocks_bots(choices) : "Bots go round it" : 1 : "" = [ 1 : "Yes" 0 : "No" ]
	friendly_damage(choices) : "Own team can damage it" : 0 : "" = [ 0 : "No" 1 : "Yes" ]
	fit(choices) : "Span the corridor" : "" : "Map packs: stretch the barricade along this axis until it meets the walls (up to 400 units each way). Without a model it's drawn as a beam fence." = [ "" : "No" "x" : "Along x (east-west)" "y" : "Along y (north-south)" ]
	size(string) : "Box size (x y z)" : "64 16 80" : "Map packs: the barricade's box when it isn't a brush."
	model(studio) : "Model" : : "Map packs: a model to show instead of the beam fence."
	adopt(string) : "Take over" : : "Map packs: the Name or *model of an existing func_wall/func_breakable to turn into this barricade."
]

@PointClass base(LsName, LsTarget) size(-16 -16 0, 16 16 72) color(255 40 40) = ls_wave_spawner : "Where waves of enemies come from (Last Stand). Waves are shared by every spawner on the map."
[
	team(choices) : "Enemies' team" : 1 : "Dead players (bots first) of this team come back here, unless a mode spawns its own enemies." = [ 1 : "Terrorists" 2 : "Counter-Terrorists" ]
	wave_min(integer) : "Enemies in wave 1" : 4 : "From this spawner."
	wave_max(integer) : "Enemies in the last wave" : 12 : ""
	waves(integer) : "Waves" : 10 : ""
	rate(float) : "Seconds between enemies" : 1.5 : ""
	radius(float) : "Spread" : 64 : "Enemies appear within this distance."
	types(string) : "Enemy types" : : "Passed to the mode (creatures.ini types: runner brute ...)."
	auto(choices) : "Starts by itself" : 0 : "" = [ 0 : "No (a mode starts it)" 1 : "Yes" ]
	prepare(float) : "First wave after" : 30 : "Seconds after the round starts, when it starts by itself."
	between(float) : "Seconds between waves" : 15 : ""
	humans(choices) : "Also bring back people" : 0 : "Dead human players come back as enemies too." = [ 0 : "No" 1 : "Yes" ]
]

@PointClass base(LsName) size(-8 -8 -8, 8 8 8) color(120 200 255) = ls_moving_platform : "Tells bots about a func_train / func_plat (they wait for it and ride it) and reports when it stops and starts."
[
	platform(target_destination) : "Train or platform" : : "Its Name, or its brush model (*12) in a map pack."
	auto(float) : "Sets off after" : -1 : "Seconds after the round starts (-1 = never by itself)."
]

// ---- creatures (the ReGameDLL fork's creature framework, docs/CREATURES.md) ------------------------

@PointClass size(-16 -16 0, 16 16 72) color(120 200 60) studio("models/zombie.mdl") = ls_creature : "A creature placed in the map (needs Loner-Strike's game DLL; types from creatures.ini). It comes back every round."
[
	type(choices) : "Type" : "zombie" : "A type from creatures.ini (the Creature Studio makes more); any name works." =
	[
		"zombie" : "Zombie"
		"runner" : "Runner"
		"brute" : "Brute"
		"spitter" : "Spitter"
		"hound" : "Hound"
		"turret" : "Turret"
		"boss" : "Boss"
		"headcrab" : "Headcrab"
		"vortigaunt" : "Vortigaunt"
		"babygarg" : "Baby gargantua"
		"snark" : "Snark"
		"babycrab" : "Baby headcrab"
		"miniturret" : "Mini turret"
		"assassin" : "Assassin"
		"soldier" : "Soldier"
		"gonarch" : "Gonarch"
	]
	behaviour(choices) : "Behavior" : "" : "Empty: the type's own." =
	[
		"" : "The type's own"
		"idle" : "Idle"
		"wander" : "Wander round its spot"
		"patrol" : "Patrol (a path_corner chain)"
		"guard" : "Guard its spot"
		"chase" : "Hunt (always knows where you are)"
		"flee" : "Run away"
	]
	path(target_destination) : "Patrol path" : : "The first path_corner of its patrol."
	radius(float) : "Range" : : "How far it wanders, patrols or guards from its spot (empty: the type's)."
	respawn(float) : "Comes back after" : : "Seconds after it dies (0 = next round; empty: the type's)."
	health(integer) : "Health" : : "Empty: the type's."
	speed(float) : "Speed" : : "Running speed (empty: the type's)."
	damage(float) : "Damage" : : "Per hit (empty: the type's)."
	aggression(float) : "Aggression" : : "0 only fights back .. 1 attacks anyone it notices (empty: the type's)."
	detect(float) : "Sight range" : : "Empty: the type's."
	hates(choices) : "Attacks" : "" : "" = [ "" : "The type's own" "all" : "Everyone" "t" : "Terrorists" "ct" : "Counter-Terrorists" ]
	persist(choices) : "Body stays" : 0 : "Hidden until it comes back instead of removed." = [ 0 : "No" 1 : "Yes" ]
	friendly(choices) : "Side" : "" : "On the players' side: shoots creatures only, and creatures attack it (a turret the players own)." = [ "" : "The type's own" "0" : "Enemy" "1" : "Players' side" ]
	tier(choices) : "Tier" : 1 : "A tougher variant: tier 2 glows yellow, tier 3 red-orange and is a little bigger (the type may give it more health)." = [ 1 : "1 (normal)" 2 : "2" 3 : "3" ]
	angles(string) : "Facing (pitch yaw roll)" : "0 0 0" : ""
]

@PointClass size(-16 -16 -32, 16 16 0) color(200 120 60) studio("models/barnacle.mdl") = ls_barnacle : "A barnacle on the ceiling (needs Loner-Strike's game DLL). Put it right under the ceiling: its tongue hangs to the floor, and a player who walks into it is hauled up and chewed until someone shoots it. It comes back every round."
[
	health(integer) : "Health" : 25 : "Shots it takes."
	damage(float) : "Bite" : 10 : "Damage a bite, one a second."
	length(float) : "Longest tongue" : 512 : "It hangs to the floor below, at most this far."
	speed(float) : "Haul speed" : 80 : "How fast it pulls a player up (units a second)."
	hates(choices) : "Catches" : "all" : "" = [ "all" : "Everyone" "t" : "Terrorists" "ct" : "Counter-Terrorists" ]
]
