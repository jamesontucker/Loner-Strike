// ---- more stock entities: random logic, game rules, trains, turrets, chargers, pickups ------
// Each one checked against the game DLL Loner-Strike ships (its key handling and flags).
// A key left empty is what the game uses when the key isn't there, so the defaults here are
// the game's own (some are 0 and do nothing: the help and the checks say which).

@BaseClass = RandomTargets
[
	target_count(integer) : "How many targets" : 0 : "Picks among the first this many targets (at most 16). With 3 it picks Target 1, 2 or 3."
	target0(target_destination) : "Target 1"
	target1(target_destination) : "Target 2" : : "The first name it can pick from (the even keys hold the others, up to 16)."
	target2(target_destination) : "Target 3"
	target3(target_destination) : "Target 4" : : "Another name it can pick from."
	target4(target_destination) : "Target 5"
	target5(target_destination) : "Target 6" : : "Another name it can pick from."
	target6(target_destination) : "Target 7"
	target7(target_destination) : "Target 8" : : "Another name it can pick from."
	target8(target_destination) : "Target 9"
	target9(target_destination) : "Target 10" : : "Another name it can pick from."
	target10(target_destination) : "Target 11"
	target11(target_destination) : "Target 12" : : "Another name it can pick from."
	target12(target_destination) : "Target 13"
	target13(target_destination) : "Target 14" : : "Another name it can pick from."
	target14(target_destination) : "Target 15"
	target15(target_destination) : "Target 16" : : "Another name it can pick from."
]
@BaseClass = RandomWait
[
	min_delay(float) : "Shortest wait (seconds)" : 0 : "Timed: the shortest random wait before each pick. Both waits must be above 0 or it picks once and stops."
	max_delay(float) : "Longest wait (seconds)" : 0 : "Timed: the longest random wait before each pick."
]
