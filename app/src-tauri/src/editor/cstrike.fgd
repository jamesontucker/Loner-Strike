@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) color(255 128 0) = trigger_setorigin : "Moves entities to another entity when set off (or keeps them following it): a lift that carries a sprite, a light that follows a train."
[
	target(target_destination) : "Moves" : : "The name of the entities to move (up to 64)."
	copypointer(target_destination) : "Moves them to" : : "The entity whose position (and turn, if asked) they copy."
	offset(string) : "Offset (x y z)" : "0 0 0" : "Added to the copied position."
