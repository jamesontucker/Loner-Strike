# /etc/lonerstrike-list/community.env  (root:root, mode 0600) - read by lonerstrike-list.service only.
# install.sh makes it from this file once (with a fresh admin token) and never overwrites it.
# Secrets: fill them in on the box only; never commit them, never paste them in a chat.

# moderation from lsmod.py (Authorization: Bearer ...); 32+ characters. install.sh makes one.
# The admin API answers only on the box (reach it with ssh -L 8100:127.0.0.1:8100).
COMMUNITY_ADMIN_TOKEN=
# the publish workflow's token (GitHub secret COMMUNITY_PUBLISH_TOKEN): it can only download the
# index from /community/publish/index; install.sh makes it
COMMUNITY_PUBLISH_TOKEN=

# the bot application "Loner-Strike Setup": posts the mod channel's cards and handles buttons
DISCORD_BOT_TOKEN=
# public, from `python3 discord-setup.py` (or the developer portal's General Information page)
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=

# where the cards go and who may press the buttons (not secret)
DISCORD_GUILD_ID=1568421500636233748
DISCORD_CHANNEL_ID=1570640821320159252
DISCORD_MOD_ROLES=1568425985504968768,1568425984288362637
DISCORD_OWNER_ID=310619637727363072

# fallback when the bot can't post: the channel's webhook (https://discord.com/api/webhooks/...)
COMMUNITY_MOD_WEBHOOK=
