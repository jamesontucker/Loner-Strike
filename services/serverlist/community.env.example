# /etc/lonerstrike-list/community.env  (root:root, mode 0600) - read by lonerstrike-list.service only.
# install.sh makes it from this file once (with a fresh admin token) and never overwrites it.
# Secrets: fill them in on the box only; never commit them, never paste them in a chat.

# moderation from lsmod.py (Authorization: Bearer ...); 32+ characters. install.sh makes one.
# The admin API answers only on the box (reach it with ssh -L 8100:127.0.0.1:8100).
COMMUNITY_ADMIN_TOKEN=
# the publish workflow's token (GitHub secret COMMUNITY_PUBLISH_TOKEN): it can only download the
# index from /community/publish/index; install.sh makes it
COMMUNITY_PUBLISH_TOKEN=

# the bot application "Loner-Strike Setup": posts the mod channel's cards and handles buttons
DISCORD_BOT_TOKEN=
# public, from `python3 discord-setup.py` (or the developer portal's General Information page)
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=

# where the cards go and who may press the buttons (not secret, but fill them in on the box:
# Discord's Developer Mode > right-click > Copy ID). Role lists are comma separated.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# the public #new-on-community channel: a card (no buttons but links) when a creation is first
# listed or a new file replaces its listed one (empty: no public feed)
DISCORD_PUBLIC_CHANNEL_ID=
DISCORD_MOD_ROLES=
DISCORD_OWNER_ID=

# "Apply for a role": the private applications channel (discord-setup.py --apply prints its id)
# and who may approve or deny (Moderator, Dev, G-Man; the owner always may)
DISCORD_APPLY_CHANNEL_ID=
DISCORD_APPLY_ROLES=
# roles with powers: only the owner or someone who has the role may give it (names or keys; Moderator always)
DISCORD_APPLY_PRIVILEGED=moderator

# fallback when the bot can't post: the channel's webhook (https://discord.com/api/webhooks/...)
COMMUNITY_MOD_WEBHOOK=
# Community roles (roles.py, --roles-db; docs/ROLES.md). The Polar webhook's signing secret: set it with
# set-env.sh from stdin, never here. Discord roles that may decide server moderator applications for servers
# that let Discord moderators decide (official servers always do): put the Moderator role's id here.
POLAR_WEBHOOK_SECRET=
DISCORD_SERVERMOD_DECIDERS=
# supporter VIP per one-time donation: days, stacking (0: for good), and the least that counts, in cents
# net of discounts (a $0 pay-what-you-want download never counts; USD, EUR, GBP and CHF are counted by their
# own cents, other currencies are logged for the team instead)
POLAR_SUPPORTER_DAYS=30
POLAR_SUPPORTER_MIN_CENTS=300
# the Polar product ids that make a Supporter, comma separated (the one-time and the monthly support products).
# Nothing else the organization sells ever does; empty: nothing counts (a warning at start)
POLAR_SUPPORTER_PRODUCTS=
