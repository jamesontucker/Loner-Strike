+						g_eSettings[DHUD_FADEOUTTIME] = _:floatclamp(str_to_float(szValue), 0.01, 30.0)
+					else if(equal(szKey, "DICE_LOG"))
+						g_eSettings[DICE_LOG] = _:clamp(str_to_num(szValue), 0, 1)
+				}
+			}
+		}
+		
+		fclose(iFilePointer)
+		
+		if(g_eSettings[ROUND_START_DELAY] > 0)
+			g_blDelayed = true
+	}
