+/* CZ server patch: bots roll the dice too */
+
+ScheduleBotRolls()
+{
+	new iChance = clamp(get_pcvar_num(g_pBotChance), 0, 100)
+
+	if(!iChance || !g_eSettings[DICE_ENABLED])
+		return
+
+	new Float:flMax = floatmax(6.0, get_pcvar_float(g_pBotDelay))
+	new iPlayers[32], iNum, iBot
+	get_players(iPlayers, iNum, "d")
+
+	for(new i; i < iNum; i++)
+	{
+		iBot = iPlayers[i]
+		remove_task(iBot + TASK_BOTROLL)
+
+		if(random_num(1, 100) <= iChance)
+			set_task(random_float(4.0, flMax), "BotTryRoll", iBot + TASK_BOTROLL)
+	}
+}
+
+public BotTryRoll(iTask)
+{
+	new id = iTask - TASK_BOTROLL
+
+	if(!is_user_connected(id) || !is_user_alive(id) || g_blFreeze)
+		return
+
+	new iPerRound = get_pcvar_num(g_pPerRound)
+
+	if(iPerRound > 0 && g_iRoundRolls[id] >= iPerRound)
+		return
+
+	// someone is rolling, or a human is waiting for a turn: try again a bit later
+	if(g_blActive || g_blDelayed || (g_iHumanWaiting && is_user_connected(g_iHumanWaiting) && is_user_alive(g_iHumanWaiting)))
+	{
+		set_task(random_float(3.0, 9.0), "BotTryRoll", iTask)
+		return
+	}
+
+	g_bSilent = true
+	RollTheDice(id)
+	g_bSilent = false
+}
