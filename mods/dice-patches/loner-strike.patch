+public client_putinserver(id)
+{
+	g_iLastRoll[id] = 0
+	g_iRoundRolls[id] = 0
+	g_szIP[id][0] = EOS
+
+	// bots (and the listen-server host) share an address, so only remember real remote players
+	if(is_user_bot(id))
+		return
+
+	get_user_ip(id, g_szIP[id], charsmax(g_szIP[]), 1)
+
+	if(equal(g_szIP[id], "loopback") || equal(g_szIP[id], "127.0.0.1"))
+		g_szIP[id][0] = EOS
+	else if(TrieKeyExists(g_tLastRolls, g_szIP[id]))
+		TrieGetCell(g_tLastRolls, g_szIP[id], g_iLastRoll[id])
+}
